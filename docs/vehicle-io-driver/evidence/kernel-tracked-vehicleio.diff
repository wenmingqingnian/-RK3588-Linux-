diff --git a/arch/arm64/boot/dts/rockchip/rk3588s-atk-quarkpi-ca2.dts b/arch/arm64/boot/dts/rockchip/rk3588s-atk-quarkpi-ca2.dts
index df8ab7f06..c7f3cc6c6 100755
--- a/arch/arm64/boot/dts/rockchip/rk3588s-atk-quarkpi-ca2.dts
+++ b/arch/arm64/boot/dts/rockchip/rk3588s-atk-quarkpi-ca2.dts
@@ -15,6 +15,20 @@
 / {
 	model = "Rockchip RK3588S EVB8 LP4X V10 Board";
 	compatible = "rockchip,rk3588s-evb8-lp4x-v10", "rockchip,rk3588";
+
+	vehicle-io {
+		compatible = "alientek,quarkpi-vehicle-io";
+
+		pinctrl-names = "default";
+		pinctrl-0 = <&vehicle_io_pins>;
+
+		reverse-gpios = <&gpio4 RK_PA2 GPIO_ACTIVE_LOW>;
+		acc-gpios = <&gpio4 RK_PA4 GPIO_ACTIVE_LOW>;
+		button-gpios = <&gpio4 RK_PA5 GPIO_ACTIVE_LOW>;
+
+		debounce-ms = <20>;
+		status = "okay";
+	};
 };
 
 &i2c3 {
@@ -67,4 +81,13 @@ ap3216c_int_pin: ap3216c-int-pin {
 			rockchip,pins = <4 RK_PA1 RK_FUNC_GPIO &pcfg_pull_up>;
 		};
 	};
+
+	vehicle-io {
+		vehicle_io_pins: vehicle-io-pins {
+			rockchip,pins =
+				<4 RK_PA2 RK_FUNC_GPIO &pcfg_pull_up>,
+				<4 RK_PA4 RK_FUNC_GPIO &pcfg_pull_up>,
+				<4 RK_PA5 RK_FUNC_GPIO &pcfg_pull_up>;
+		};
+	};
 };
