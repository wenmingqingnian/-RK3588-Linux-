diff --git a/drivers/input/misc/Kconfig b/drivers/input/misc/Kconfig
index 362e8a019..61570882c 100644
--- a/drivers/input/misc/Kconfig
+++ b/drivers/input/misc/Kconfig
@@ -576,6 +576,21 @@ config INPUT_PWM_VIBRA
 	  To compile this driver as a module, choose M here: the module will be
 	  called pwm-vibra.
 
+config INPUT_QUARKPI_VEHICLE_IO
+	tristate "QuarkPi Vehicle I/O driver"
+	depends on OF
+	select GPIOLIB
+	help
+	  Say Y here to enable the QuarkPi-CA2 Vehicle I/O platform driver.
+	  This driver monitors vehicle signals (reverse, ACC and button) via
+	  GPIO interrupts and reports them as EV_KEY events through the
+	  Linux Input subsystem.
+
+	  To compile this driver as a module, choose M here: the module
+	  will be called quarkpi-vehicle-io.
+
+	  If unsure, say N.
+
 config INPUT_RK805_PWRKEY
 	tristate "Rockchip RK805 PMIC power key support"
 	depends on MFD_RK808
